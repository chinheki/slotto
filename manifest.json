{
  "manifest_version": 3,
  "name": "Slotto",
  "description": "Generate interview availability, reserve pending slots, and capture confirmed schedules from recruiter messages.",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Slotto",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "storage",
    "activeTab",
    "identity",
    "identity.email",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://mail.google.com/*",
    "https://www.linkedin.com/*",
    "https://www.bizreach.jp/*",
    "https://www.green-japan.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://www.linkedin.com/*",
        "https://www.bizreach.jp/*",
        "https://www.green-japan.com/*"
      ],
      "js": [
        "src/content/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/reminders/character.png",
        "assets/reminders/character-128.png"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://www.linkedin.com/*",
        "https://www.bizreach.jp/*",
        "https://www.green-japan.com/*"
      ]
    }
  ]
}

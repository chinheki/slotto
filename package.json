{
  "name": "interview-scheduler-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-icons.js && vite build && node scripts/copy-extension-files.js",
    "dev": "vite build --watch",
    "web:dev": "node scripts/generate-icons.js && vite --config web/vite.config.js --host 0.0.0.0 --port 5173 --strictPort",
    "web:build": "node scripts/generate-icons.js && vite build --config web/vite.config.js",
    "test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.17",
    "japanese-holidays": "^1.0.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
